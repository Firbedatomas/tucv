# ==========================================================================
# TuCV - variables de PRODUCCION (Hetzner)
# Copiá este archivo a ".env" en el servidor y completá los valores.
# NO lo subas a git.
#
# OJO: NEXT_PUBLIC_* se hornean en el BUILD de la imagen (ver Dockerfile /
# docker-compose.hetzner.yml `args`), no alcanza con ponerlas acá si ya
# hiciste `docker compose build` antes de completarlas — volvé a buildear.
# ==========================================================================

# URL pública de PocketBase. Requiere el DNS de pb.tucv.ar apuntando a este
# servidor y el bloque correspondiente en el Caddyfile compartido (ver
# checklist de deploy en README.md).
NEXT_PUBLIC_POCKETBASE_URL=https://pb.tucv.ar

# Dominio público (https). De acá salen los links/QR que se comparten.
NEXT_PUBLIC_BASE_URL=https://tucv.ar

# Analytics (Plausible self-hosted en analytics.tucv.ar). Sin estas dos
# seteadas, app/layout.tsx no inyecta el script.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=tucv.ar
NEXT_PUBLIC_PLAUSIBLE_SRC=https://analytics.tucv.ar/js/script.file-downloads.hash.outbound-links.pageview-props.revenue.tagged-events.js

# Filtros de sexo/edad en el panel de postulantes y en "Buscar candidatos":
# prendidos (decisión explícita de producto, ver README).
NEXT_PUBLIC_FEATURE_FILTERS_GENDER_AGE=true

# Superusuario de PocketBase. La usa /api/public-job/[slug] server-side,
# corriendo DENTRO del contenedor `app` -> tiene que ser el nombre del
# servicio en la red de Docker (tucv-pb:8090), NO 127.0.0.1 (eso sería el
# propio contenedor `app`, no PocketBase). Para correr scripts/seed.js a mano
# desde el HOST en cambio hay que pisar esta variable con
# POCKETBASE_URL=http://127.0.0.1:8092 (el puerto publicado al host).
# Usá una contraseña larga y propia, no la del ejemplo de desarrollo.
POCKETBASE_URL=http://tucv-pb:8090
PB_ADMIN_EMAIL=admin@tucv.ar
PB_ADMIN_PASSWORD=

# Login con Google (único método de auth de empresa y postulante). Las lee
# PocketBase directamente (pb_hooks/main.pb.js, onBootstrap), NO la app de
# Next. Hace falta un OAuth Client ID de tipo "Web application" en Google
# Cloud Console con el redirect URI
# https://pb.tucv.ar/api/oauth2-redirect habilitado. Sin estas dos
# variables el login queda deshabilitado (PocketBase arranca igual).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Autocomplete de direcciones/zonas (Google Places API New). Server-only a
# propósito (sin NEXT_PUBLIC_) -- la lee la app de Next server-side (route
# handler), nunca viaja al navegador. Restringila en Google Cloud Console
# por IP del servidor (no por dominio, ya que no se usa desde el browser),
# y por API a "Places API (New)" únicamente.
GOOGLE_MAPS_API_KEY=

# Mercado Pago (Checkout Pro): activa el pago real del plan Pro desde
# /empresa/perfil. Sacala de https://www.mercadopago.com.ar/developers/panel
# -> Tus integraciones -> credenciales. Un Access Token que empieza con
# "APP_USR-" es de PRODUCCIÓN (cobra de verdad); uno "TEST-" es de prueba.
# Sin esto seteado, el botón "Actualizar a Pro" muestra un error claro en
# vez de romper el resto del sitio.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PLAN_PRO_PRICE=9900

# Emails transaccionales (ver lib/email/). Dominio remitente (tucv.ar) tiene
# que estar verificado en Resend (SPF/DKIM configurados en el DNS real,
# agregá también un registro DMARC en _dmarc.tucv.ar) antes de mandar desde
# impacto@tucv.ar. Sin esto seteado, la app sigue funcionando pero no manda
# ningún email (mismo criterio que MERCADOPAGO_ACCESS_TOKEN).
RESEND_API_KEY=
RESEND_FROM_EMAIL=TuCV <impacto@tucv.ar>

# Firma (Svix) del webhook -- Resend Dashboard -> Webhooks -> tu endpoint
# (https://tucv.ar/api/webhooks/resend) -> "Signing Secret".
RESEND_WEBHOOK_SECRET=

# Firma (Svix) del webhook de RECEPCIÓN de correo (email.received), distinto
# del de arriba -- alimenta el correo interno del admin. Se completa cuando
# se configure el endpoint de Inbound en el dashboard de Resend -> Webhooks
# -> tu endpoint (https://tucv.ar/api/webhooks/resend-inbound) -> Signing
# Secret. Ver app/api/webhooks/resend-inbound/route.ts.
RESEND_INBOUND_WEBHOOK_SECRET=

# Secreto compartido entre el contenedor de PocketBase (que dispara los
# emails vía $http.send desde pb_hooks/main.pb.js) y
# app/api/email/trigger/route.ts en el contenedor `app`. Generar con
# `openssl rand -hex 32`. Va en este mismo .env, que ambos contenedores
# comparten (ver docker-compose.hetzner.yml, env_file).
EMAIL_TRIGGER_SECRET=

# URL con la que el contenedor `pocketbase` llega al contenedor `app` por
# la red interna de Docker (nombre del servicio, no localhost). En
# docker-compose.hetzner.yml el container_name de la app es "tucv-app".
APP_INTERNAL_URL=http://tucv-app:3000

# Crons (app/api/cron/daily, /weekly, /flush-email-queue). Agregar en el
# crontab del VPS algo como:
#   0 9 * * * curl -s -X POST -H "Authorization: Bearer $CRON_SECRET" https://tucv.ar/api/cron/daily
#   0 9 * * 1 curl -s -X POST -H "Authorization: Bearer $CRON_SECRET" https://tucv.ar/api/cron/weekly
#   0 * * * * curl -s -X POST -H "Authorization: Bearer $CRON_SECRET" https://tucv.ar/api/cron/flush-email-queue
# El flush (cada hora) vacía la cola de emails diferidos por horario
# silencioso. Generar con `openssl rand -hex 32`. Sin esto seteado, las
# rutas devuelven 503 sin mandar nada.
CRON_SECRET=

# Panel de admin (/admin): único email autorizado a entrar con Google, y
# secreto para firmar la cookie de sesión propia (ver lib/admin-session.ts).
# Generar el secreto con `openssl rand -hex 32`. Server-only, no requiere
# rebuild de imagen -- alcanza con completarla en el .env del servidor y
# `docker compose restart app`.
ADMIN_EMAIL=
ADMIN_SESSION_SECRET=

# Embudo/visitas del panel de admin: consultan la Stats API v2 de Plausible.
# PLAUSIBLE_SITE_ID/BASE_URL tienen default en código (tucv.ar /
# https://analytics.tucv.ar). PLAUSIBLE_API_KEY se genera a mano en
# https://analytics.tucv.ar -> Settings -> API Keys. Sin esto seteado,
# /admin/embudo y /admin/visitas muestran "sin datos" en vez de romper.
PLAUSIBLE_API_KEY=
PLAUSIBLE_SITE_ID=tucv.ar
PLAUSIBLE_BASE_URL=https://analytics.tucv.ar
