# ==========================================================================
# TuCV - variables de DESARROLLO (local)
# Copiá este archivo a ".env.local" y ajustá si hace falta.
# NO lo subas a git.
# ==========================================================================

# URL pública de PocketBase (la usa el navegador directamente). En local,
# corriendo `./pocketbase/pocketbase serve --http=127.0.0.1:8092`, dejar así.
NEXT_PUBLIC_POCKETBASE_URL=http://127.0.0.1:8092

# URL base del sitio (para armar los links/QR públicos de cada búsqueda).
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Analytics (Plausible): a propósito SIN setear en local -- ver
# app/layout.tsx, plausibleEnabled queda en false sin estas dos, así el
# tráfico de desarrollo no ensucia las métricas reales de tucv.ar.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_PLAUSIBLE_SRC=

# Filtros de sexo/edad en el panel de postulantes: prendidos (decisión explícita del producto).
NEXT_PUBLIC_FEATURE_FILTERS_GENDER_AGE=true

# Solo para scripts (seed, etc.), no lo lee la app en runtime.
POCKETBASE_URL=http://127.0.0.1:8092
PB_ADMIN_EMAIL=admin@tucv.local
PB_ADMIN_PASSWORD=TucvAdmin123!

# Login con Google (único método de auth de empresa y postulante). Las lee
# PocketBase directamente (pb_hooks/main.pb.js, onBootstrap), NO la app de
# Next — hace falta un OAuth Client ID de tipo "Web application" en Google
# Cloud Console con el redirect URI
# http://127.0.0.1:8092/api/oauth2-redirect habilitado. Sin estas dos
# variables el login queda deshabilitado (PocketBase arranca igual).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Autocomplete de direcciones/zonas (Google Places API New). Server-only a
# propósito (sin NEXT_PUBLIC_). La key de producción está restringida por
# IP del servidor -- no va a funcionar acá en local a menos que generes una
# key aparte (o sumes tu IP a la restricción) para desarrollo.
GOOGLE_MAPS_API_KEY=

# Panel de admin (/admin): único email autorizado a entrar con Google, y
# secreto para firmar la cookie de sesión propia (ver lib/admin-session.ts).
# Generar el secreto con `openssl rand -hex 32`.
ADMIN_EMAIL=
ADMIN_SESSION_SECRET=

# Embudo/visitas del panel de admin (/admin/embudo, /admin/visitas): para
# probarlos en local hace falta la MISMA API key de analytics.tucv.ar (no
# hay una instancia de Plausible aparte para desarrollo). Generarla en
# Settings -> API Keys una vez logueado ahí. Sin esto, esas páginas
# muestran "sin datos" en vez de romper.
PLAUSIBLE_API_KEY=
PLAUSIBLE_SITE_ID=tucv.ar
PLAUSIBLE_BASE_URL=https://analytics.tucv.ar

# Emails transaccionales (ver lib/email/). Sacá la API key de
# https://resend.com/api-keys -- necesita el dominio remitente (tucv.ar)
# verificado en Resend (SPF/DKIM) antes de poder mandar desde
# impacto@tucv.ar. Sin RESEND_API_KEY seteada, lib/email/client.ts no manda
# nada pero el resto del sitio sigue funcionando (mismo criterio que
# MERCADOPAGO_ACCESS_TOKEN).
RESEND_API_KEY=
RESEND_FROM_EMAIL=TuCV <impacto@tucv.ar>

# Firma (Svix) del webhook de Resend -- Dashboard de Resend -> Webhooks ->
# tu endpoint -> "Signing Secret". Verifica app/api/webhooks/resend/route.ts.
RESEND_WEBHOOK_SECRET=

# Firma (Svix) del webhook de RECEPCIÓN de correo (email.received), distinto
# del de arriba -- alimenta el correo interno del admin
# (app/api/webhooks/resend-inbound/route.ts). No aplica en local (Resend no
# le puede pegar a localhost sin un túnel tipo ngrok), dejar vacío.
RESEND_INBOUND_WEBHOOK_SECRET=

# Secreto compartido entre PocketBase (pb_hooks/main.pb.js, que dispara los
# emails con $http.send) y app/api/email/trigger/route.ts. Generar con
# `openssl rand -hex 32` -- cualquier valor sirve mientras sea el mismo acá
# y en el .env que lee el proceso de PocketBase (es el MISMO archivo .env
# en local, así que con setearla una vez alcanza).
EMAIL_TRIGGER_SECRET=

# URL con la que el proceso de PocketBase (pb_hooks) llega a la app de Next
# para disparar el email trigger de arriba. En local, ambos corren en el
# mismo host -- dejar así.
APP_INTERNAL_URL=http://127.0.0.1:3000

# Digests/vencimientos (app/api/cron/daily, app/api/cron/weekly): no hay
# ningún scheduler propio en este repo, estas rutas las tiene que pegar un
# cron externo (system crontab + curl, ver checklist de deploy en
# README.md) con este valor como "Authorization: Bearer ...". Generar con
# `openssl rand -hex 32`. Sin esto seteado, ambas rutas devuelven 503 sin
# mandar nada.
CRON_SECRET=
